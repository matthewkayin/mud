# Copy to backend/.env for local development, then run the server with:
#   set -a; . ./.env; set +a; go run .
PORT=7272
PUBLIC_URL=http://localhost:5173
ENABLE_DEBUG_AUTH=true
RC_API_URL=https://www.recurse.com/api/v1
RC_AUTH_URL=https://www.recurse.com/oauth/authorize
RC_TOKEN_URL=https://www.recurse.com/oauth/token
RC_CLIENT_ID=
RC_CLIENT_SECRET=
# Only set in the Docker image, where the server also serves the built web client
STATIC_FOLDER=
